# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Notion
NOTION_TOKEN=secret_your-integration-token
NOTION_INTAKE_DATABASE_ID=your-database-id

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key

# Anthropic — dedicated key for June (homepage demo agent)
# Lets June's spend be tracked + capped independently. Falls back to
# ANTHROPIC_API_KEY if unset.
JUNE_ANTHROPIC_API_KEY=sk-ant-june-key

# Resend (email)
RESEND_API_KEY=re_your-key
RESEND_FROM_EMAIL=hello@gb2gllc.com
RESEND_FROM="GB2G <herald@gb2gllc.com>"

# Chatbot.com (Herald white-label)
CHATBOT_API_KEY=your-developer-access-token

# Vercel cron auth (any random string ≥32 chars)
CRON_SECRET=your-random-cron-secret

# ATTOM Data (property lookups for Mark — best for owned single-family/condos)
ATTOM_API_KEY=your-attom-trial-key

# RentCast (Mark fallback — better rental/apartment coverage)
RENTCAST_API_KEY=your-rentcast-key

# Meta (Maya — Facebook + Instagram DM/comment manager)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=any-random-string-32chars-or-more

# Slack app (Mark + future Slack-resident agents)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Calendly
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/gb2g/intake-kickoff

# WorkOS (portal auth — home.gb2gllc.com)
WORKOS_API_KEY=sk_live_your-key
WORKOS_CLIENT_ID=client_your-id
WORKOS_COOKIE_PASSWORD=your-32-char-random-string

# GB2G internal
GB2G_TEAM_EMAIL=hello@gb2gllc.com
NEXT_PUBLIC_BASE_URL=https://gb2gllc.com
NEXT_PUBLIC_HOME_URL=https://home.gb2gllc.com
NEXT_PUBLIC_ADMIN_URL=https://admin.gb2gllc.com

# Stripe
STRIPE_SECRET_KEY=sk_live_your-key
ADMIN_EMAIL=john@gb2gllc.com
